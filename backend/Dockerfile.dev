# =============================================================================
# Dockerfile.dev - Desarrollo con hot-reload
# =============================================================================
FROM golang:1.26-alpine

WORKDIR /app

RUN apk add --no-cache git ca-certificates wget

COPY go.mod go.sum ./
RUN go mod download

ENV GIN_MODE=debug
ENV CGO_ENABLED=0

EXPOSE 8080

CMD ["go", "run", "./cmd/api"]
